/*
 * Aurora Corne rev1.1 — QWERTY, laid out to echo the Moonlander config.
 *
 * 0 BASE  QWERTY, LEDs off
 * 1 NUM   left-hand symbols, right-hand numpad   hold middle left thumb (space)
 * 2 NAV   F-keys, arrows, media, ctrl-digits     hold inner left thumb (bspc)
 * 3 SYS   Bluetooth, RGB, reset                  hold both, or latch with T3
 *
 * The outermost thumb on each half is the encoder position and has no switch.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
/*
 * Scroll speed, in units/second. &msc accumulates speed * 16ms per tick and
 * reports only whole units, discarding the remainder on release — so one
 * detent must clear 1.0 within tap-ms below or it scrolls nothing at all.
 * 30 over 120ms gives ~3 lines per detent.
 */
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30
#include <dt-bindings/zmk/pointing.h>

/* 21 per-key LEDs per half. Trailing LEDs stay dark if this is set too low. */
&led_strip {
    chain-length = <21>;
};

/ {
    /*
     * ZMK has no layer->colour hook, so each layer key is a macro that lights
     * the strip on press and cuts it on release. RGB_OFF also drops the LED
     * power rail, so base costs nothing. &rgb_ug is global-locality, so both
     * halves follow.
     */
    macros {
        num_blue: num_blue {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_tap &rgb_ug RGB_ON>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(240,100,100)>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                , <&macro_tap &rgb_ug RGB_OFF>
                ;
        };

        nav_green: nav_green {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_tap &rgb_ug RGB_ON>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(120,100,100)>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                , <&macro_tap &rgb_ug RGB_OFF>
                ;
        };
        /*
         * &kp LC(N3) emits the digit before the ctrl bit, so Karabiner sees a
         * bare 3 and its mandatory-control rules never match. Press ctrl in its
         * own report first.
         */
        ctl_num: ctl_num {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp LCTRL>
                ;
        };
    };

    behaviors {
        /* Hold-taps whose hold half is the colour macro rather than a bare &mo. */
        lt_num: lt_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&num_blue>, <&kp>;
        };

        lt_nav: lt_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&nav_green>, <&kp>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <120>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp DEL        &kp Q        &kp W  &kp E  &kp R  &kp T           &kp Y  &kp U  &kp I      &kp O    &kp P            &kp BSLH
&nav_green 2   &kp A        &kp S  &kp D  &kp F  &kp G           &kp H  &kp J  &kp K      &kp L    &lt_nav 2 SEMI   &mt LALT SQT
&kp LSHFT      &mt LCTRL Z  &kp X  &kp C  &kp V  &kp B           &kp N  &kp M  &kp COMMA  &kp DOT  &mt RCTRL FSLH   &kp LGUI
                     &none  &lt_num 1 SPACE  &lt_nav 2 BSPC      &kp TAB  &kp RET  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_encoder>;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&kp ESC    &kp MINUS  &kp PLUS   &kp LBRC  &kp RBRC  &kp EXCL     &kp UP    &kp N7  &kp N8  &kp N9  &kp STAR   &kp F12
&trans     &kp STAR   &kp EQUAL  &kp LPAR  &kp RPAR  &kp AMPS     &kp DOWN  &kp N4  &kp N5  &kp N6  &kp PLUS   &kp GRAVE
&kp LGUI   &kp HASH   &kp DLLR   &kp LBKT  &kp RBKT  &kp PIPE     &kp N0    &kp N1  &kp N2  &kp N3  &kp BSLH   &kp TILDE
                                 &trans    &trans    &trans       &trans    &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_encoder>;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&kp LG(SPACE)  &kp F1         &kp F2         &kp F3         &kp F4         &kp F5          &kp F6      &kp F7    &kp F8      &kp F9     &kp F10    &kp F11
&trans         &ctl_num N1    &ctl_num N2    &ctl_num N3    &ctl_num N4    &ctl_num N5     &kp LEFT    &kp DOWN  &kp UP      &kp RIGHT  &kp HOME   &kp END
&tog 3         &ctl_num N6    &ctl_num N7    &ctl_num N8    &ctl_num N9    &kp LALT        &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp PG_UP  &kp PG_DN  &kp F12
                                             &trans         &trans         &trans          &trans      &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_encoder>;
        };

        sys_layer {
            display-name = "SYS";
            bindings = <
&rgb_ug RGB_TOG    &rgb_ug RGB_COLOR_HSB(0,100,100)  &rgb_ug RGB_COLOR_HSB(120,100,100)  &rgb_ug RGB_COLOR_HSB(240,100,100)  &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_EFF    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&ext_power EP_TOG  &rgb_ug RGB_HUI                   &rgb_ug RGB_SAI                     &rgb_ug RGB_BRI                     &rgb_ug RGB_SPI                 &rgb_ug RGB_ON     &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR_ALL
&tog 3             &rgb_ug RGB_HUD                   &rgb_ug RGB_SAD                     &rgb_ug RGB_BRD                     &rgb_ug RGB_SPD                 &rgb_ug RGB_OFF    &bootloader   &sys_reset    &none         &none         &none         &none
                                                                                         &trans                              &trans                          &trans             &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_encoder>;
        };
    };
};
